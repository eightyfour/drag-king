{
  "name": "@eightyfour/drag-king",
  "version": "1.0.0",
  "description": "Drag and drop to upload to server",
  "main": "main.js",
  "files": [
    "*",
    "!files"
  ],
  "watch": {
    "less": {
      "patterns": [
        "client/less"
      ],
      "extensions": "less",
      "quiet": false
    },
    "rebuild": {
      "patterns": [
        "client"
      ],
      "extensions": [
        "ts",
        "html"
      ],
      "quiet": false
    }
  },
  "config": {
    "port": {
      "development": 8001,
      "production": 80
    },
    "auth": true
  },
  "scripts": {
    "build": "npm-run-all ts js less* images*",
    "rebuild": "npm-run-all ts js",
    "watch": "npm-watch",
    "test": "node --test",
    "prejs": "mkdir -p dist .build && find client -name '*.html' -exec cp --parents -t .build {} +",
    "ts": "tsc",
    "js": "browserify -t [ stringify --extensions [.html] ] .build/client/dragKing.js -o dist/main.gen.js",
    "less": "npm-run-all less:*",
    "less:main": "lessc client/less/main.less dist/css/main.css",
    "less:auth": "lessc client/less/auth.less dist/css/auth.css",
    "postless": "npm-run-all mediumEditor:*",
    "mediumEditor:main": "cat node_modules/medium-editor/dist/css/medium-editor.min.css >> dist/css/main.css",
    "mediumEditor:theme": "cat node_modules/medium-editor/dist/css/themes/flat.min.css >> dist/css/main.css",
    "preimages": "mkdir -p dist/img",
    "images": "npm-run-all images:*",
    "images:images": "cp -rf client/images/* dist/img/.",
    "start": "node dragKing.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eightyfour/drag-king.git"
  },
  "author": "aode & phen",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/eightyfour/drag-king/issues"
  },
  "dependencies": {
    "basic-auth": "^2.0.1",
    "canny": "^0.2.1",
    "connect-busboy": "^1.0.0",
    "cookie-parser": "^1.4.4",
    "directory-tree": "^2.2.1",
    "express": "^4.22.3",
    "express-session": "^1.15.2",
    "md5": "^2.2.1",
    "medium-editor": "^5.23.3",
    "message-toast": "github:eightyfour/message-toast",
    "octicons": "^5.0.1",
    "sharp": "^0.34.5",
    "string-to-color": "github:eightyfour/string-to-color",
    "stringify": "^5.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "browserify": "^17.0.1",
    "less": "^4.4.2",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.1.7",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
